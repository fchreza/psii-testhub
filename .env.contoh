# Salin jadi .env.local lalu isi. Berkas ini AMAN untuk di-commit.
#
# Nilai asli TIDAK PERNAH ditulis di sini: repo ini publik, dan kredensial yang
# pernah masuk riwayat git harus dianggap bocor selamanya.

# Koneksi Postgres (Neon). Pakai koneksi pooled.
DATABASE_URL="postgresql://..."

# Kunci penanda sesi. Buat dengan: openssl rand -hex 32
SESI_SECRET="ganti-dengan-teks-acak-panjang"

# Pemulihan sandi mandiri (email via Resend). Gunakan domain pengirim yang
# sudah diverifikasi pada Resend dan URL HTTPS deployment production.
APP_URL="https://testhub.example.go.id"
RESEND_API_KEY=""
RESEND_FROM="PSII TestHub <noreply@example.go.id>"

# Penyimpanan bukti uji (S3-compatible; dipakai Neon Object Storage).
#
# KENAPA NAMANYA AWS_*: pustaka @aws-sdk/client-s3 hanya membaca nama itu.
# Nama lain harus dipetakan manual di lib/simpanan.ts, dan pemetaan itu satu
# tempat lagi yang bisa salah.
#
# PENTING: jangan sertakan tanda kutip saat menaruh nilai ini di Vercel.
# Nilai di berkas ini boleh dikutip karena dotenv membuang kutipnya; penyimpan
# variabel Vercel TIDAK. Nilai yang masih ber kutip akan membuat build gagal
# dengan galat "Invalid URL" yang menunjuk ke berkas yang salah.
AWS_ENDPOINT_URL_S3="https://<region>.storage.<zona>.aws.neon.tech"
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="psii-testhub"
